#include <esp_now.h>
#include <WiFi.h>

// MAC address of your Alarm Base board
uint8_t baseStationMac[] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};

typedef struct struct_message {
  int alarmState; // 1 = Triggered
} struct_message;

struct_message sensorData;
esp_now_peer_info_t peerInfo;

void setup() {
  WiFi.mode(WIFI_STA);

  if (esp_now_init() != ESP_OK) {
    return;
  }

  // Register the base station as a receiver
  memcpy(peerInfo.peer_addr, baseStationMac, 6);
  peerInfo.channel = 0;  
  peerInfo.encrypt = false;
  esp_now_add_peer(&peerInfo);

  // Send the trigger
  sensorData.alarmState = 1;
  esp_now_send(baseStationMac, (uint8_t *) &sensorData, sizeof(sensorData));

  // Configure switch on GPIO 4 to wake ESP32 on state change, then sleep
  esp_sleep_enable_ext0_wakeup(GPIO_NUM_4, 1); 
  esp_deep_sleep_start();
}

void loop() {
  // Never reached due to deep sleep
}
